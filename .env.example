# 複製此檔為 .env 後填入實際金鑰。.env 已被 .gitignore 排除，切勿提交。

# ─── 校內地端（主力）───────────────────────────────────────
# 這個端點是一個 LiteLLM proxy，同時提供多個 model id。
#
# ⚠️ **實測發現 `mistral-small-4` 與 `gpt-oss-120b` 極可能由同一個後端
#    提供服務**（三個不同 max_tokens 下 tokenizer 截斷點逐字相同）。
#    因此 judge_cross 的實質保證不成立——詳見 docs/judge_cross_pitfall.md。
#    要真正的跨模型評判，請用下方的 GOOGLE_API_KEY 走 judge_gemini profile。
#
# ⚠️ 端點會在不知情的情況下換模型。8/21 → 8/22 之間換過一次，
#    導致 186/400 的譯文改變（全部 temperature=0）。
#    重跑前先 `python scripts/endpoint_fingerprint.py` 比對指紋。
ITHU_API_BASE=<your-llm-endpoint>
ITHU_API_KEY=

# ─── 跨模型評判（judge_gemini profile）─────────────────────
# 免費層，日配額有限。config/providers.yaml 已把 rpm 限在 5。
# ⚠️ 撞到 RateLimitError 就停，不要重試——重試會把整天的額度燒掉。
#    503 ServiceUnavailable 是暫時性的，與配額無關，可以重試。
GOOGLE_API_KEY=

# ─── 未使用（保留欄位）─────────────────────────────────────
# 本專案最終未使用商用 API。保留供日後跨模型對比實驗。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── 執行參數 ──────────────────────────────────────────────
# 預設模型；可於 config/providers.yaml 覆寫
DEFAULT_PROVIDER=ithu
DEFAULT_MODEL=mistral-small-4

# 執行日誌目錄（不進版控）
RUNS_DIR=runs
