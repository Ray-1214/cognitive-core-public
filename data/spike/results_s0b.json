        "V2_biencoder_vs_src": 0.8217473095932016,
        "V3_crossencoder": 0.8975158,
        "V4_llm_intent_same": 1.0
      },
      {
        "id": "amb-10",
        "group": "ambiguous",
        "text": "我等你消息",
